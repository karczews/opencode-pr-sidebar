{
	"name": "opencode-pr-sidebar",
	"version": "0.1.0",
	"private": false,
	"type": "module",
	"description": "Current-branch GitHub PR card for the OpenCode TUI sidebar",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/karczews/opencode-pr-sidebar.git"
	},
	"exports": {
		"./tui": "./dist/tui.js"
	},
	"files": [
		"dist/tui.js",
		"dist/model.js",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"opencode": ">=2.2.6"
	},
	"scripts": {
		"fmt": "biome format --write .",
		"fmt-check": "biome format .",
		"lint": "biome lint .",
		"check:imports": "node scripts/check-imports.mjs",
		"lint:commits": "node scripts/check-commits.mjs",
		"check:audit": "node scripts/check-audit.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test test/model.test.ts",
		"test:render": "node --conditions=browser --test test/test-render.test.mjs",
		"check": "npm run fmt-check && npm run lint && npm run check:imports && npm run typecheck && npm run verify:dist && npm test && npm run test:register && npm run test:render",
		"test:register": "node --conditions=browser --test test/tui-register.test.mjs",
		"compile": "node scripts/compile.mjs",
		"verify:dist": "npm run compile && git diff --exit-code -- dist"
	},
	"peerDependencies": {
		"@opentui/core": ">=0.6.6",
		"@opentui/solid": ">=0.6.6",
		"solid-js": ">=1.9.0"
	},
	"peerDependenciesMeta": {
		"@opentui/core": {
			"optional": true
		},
		"@opentui/solid": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@opencode/client": "2.2.6",
		"@opencode/plugin": "2.2.6",
		"@opencode/theme": "2.2.6",
		"@opentui/core": "0.8.3",
		"@opentui/solid": "0.8.3",
		"@types/node": "26.6.6",
		"solid-js": "1.9.18",
		"typescript": "5.9.3"
	}
}
